# Nur für die lokale Entwicklung: in ".env" umbenennen und ausfüllen, dann "npm start".
# Im Docker-Stack kommen diese Werte aus der .env im Hauptordner.

# Discord Developer Portal -> eure Anwendung (zum Entwickeln am besten eine eigene Test-Anwendung)
#   General Information -> Application ID  => AUTH_DISCORD_ID
#   Bot -> Token                            => DISCORD_BOT_TOKEN
AUTH_DISCORD_ID=
DISCORD_BOT_TOKEN=

# Testserver: "npm run register" meldet die Befehle nur dort an (sofort sichtbar).
# Server-ID: Discord-Entwicklermodus einschalten, Rechtsklick auf den Server -> Server-ID kopieren
BOT_DEV_GUILD_ID=

# Datenbank des Community-Managers (Werte der lokalen Testumgebung aus dev.ps1)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hangar
DB_USER=hangar
DB_PASSWORD=hangar
