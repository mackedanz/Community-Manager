# Einstellungen für den Docker-Stack. In ".env" umbenennen und ausfüllen.

# Öffentliche Adresse ohne https://, z. B. hangar.example.de
DOMAIN=

# Discord Developer Portal -> eure Anwendung -> OAuth2
# Dort unter "Redirects" eintragen: https://<DOMAIN>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Schlüssel, mit dem die App die gespeicherten Discord-Tokens verschlüsselt (Pflicht, mindestens 32 Zeichen).
# Erzeugen: openssl rand -base64 32   Danach gut sichern (Passwortmanager) und NICHT mehr ändern. Geht er verloren,
# melden sich alle einmal neu mit Discord an; Hangar und Termine bleiben erhalten.
APP_KEY=

# Passwort der Datenbank (frei wählbar, nur für die Verbindung zwischen App und Datenbank)
DB_PASSWORD=

# Discord-ID des Betreibers: nur dieser Nutzer sieht den Bereich /admin (Orgas löschen, Server sperren).
# Mehrere IDs mit Komma trennen (z. B. für eine Übergabe). Leer = kein Admin-Bereich.
# Wechsel: ID hier ändern und "docker compose up -d" ausführen, ein Neubau ist nicht nötig.
SERVER_ADMIN_DISCORD_ID=

# Optional: Links zu Impressum und Datenschutzerklärung des Betreibers (öffnen in neuem Tab).
# Ohne LEGAL_PRIVACY_URL zeigt der Footer die eingebaute Datenschutzseite (Platzhalter);
# ohne LEGAL_IMPRINT_URL erscheint kein Impressum-Link.
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=

# Optional: Katalog-Aktualisierung in Sekunden (Standard: 7200 = alle 2 Stunden)
# CATALOG_SYNC_INTERVAL_SECONDS=7200

# Discord-Bot (eigener Container, nutzt AUTH_DISCORD_ID, DISCORD_BOT_TOKEN und die Datenbank; mehr in BOT/README.md)
#   Discord Developer Portal -> eure Anwendung -> Bot -> Token  => DISCORD_BOT_TOKEN
#   Bot -> "Server Members Intent" einschalten, "Public Bot" ausschalten
#   General Information -> "Interactions Endpoint URL" bleibt LEER (sonst kommen die Befehle nicht beim Bot an)
# Einschalten mit COMPOSE_PROFILES=bot, dann "docker compose up -d" und einmalig die Befehle anmelden:
#   docker compose exec bot node src/register.js --global
# COMPOSE_PROFILES=bot
# DISCORD_BOT_TOKEN=
# Twitch-Live-Meldungen (optional): Anwendung auf dev.twitch.tv anlegen (Konsole -> Anwendung registrieren), dann beides eintragen
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Optional: 1 = nur Mitglieder auf der Zugangsliste des Bots (und Server-Admins) dürfen sich anmelden.
# Du selbst kommst über SERVER_ADMIN_DISCORD_ID immer herein. Achtung: Beim Abgleich der Mitglieder werden die Konten
# von Personen gelöscht, die auf keiner Zugangsliste mehr stehen. Erst einschalten, wenn die Liste stimmt.
# LOGIN_REQUIRES_ALLOWLIST=0

# Port auf dem Server, an den der Reverse-Proxy (z. B. Nginx Proxy Manager) weiterleitet (Standard: 8181)
# HANGAR_PORT=8181
# Adresse, an die der Port gebunden wird. Standard: alle Schnittstellen, damit ein Proxy auf einem anderen Rechner
# herankommt. Läuft der Proxy auf demselben Server, 127.0.0.1 setzen (dann ist der Port nur dort erreichbar). Steht der
# Proxy auf einem anderen Rechner, die IP dieses Servers im Heimnetz eintragen und zusätzlich per Firewall
# (z. B. ufw: nur die Proxy-IP auf Port 8181 erlauben) absichern.
# HANGAR_BIND=0.0.0.0

# Bei öffentlichem Bot dringend setzen: nur diese Discord-Server (IDs, mit Komma getrennt) dürfen per /einrichten
# eine Orga anlegen. Leer = jeder Server, auf dem der Bot ist. Server-ID: Discord-Entwicklermodus, Rechtsklick auf den Server.
# ONBOARDING_GUILD_IDS=
